FROM golang:1.22-bookworm AS builder

WORKDIR /src
COPY go-service/go.mod go-service/go.sum ./
RUN go mod download

COPY go-service ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/compare-proxy ./cmd/compareproxy

FROM debian:bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/compare-proxy /app/compare-proxy

EXPOSE 8080

ENTRYPOINT ["/app/compare-proxy"]
